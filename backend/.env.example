# Copy this file to .env and enter the local development credentials.
# Do not share credentials in chat or commit .env.
APP_ENV=development
APP_NAME=Laxmi Narasimha Rentals API
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_MFA_REQUIRED=true

DB_HOST=localhost
DB_PORT=5432
DB_NAME=laxmi_narasimha_rentals
DB_USER=lnr_app
DB_PASSWORD=replace-with-your-local-password

# Generate random values locally. AUTH_SECRET_KEY must contain at least 32 characters.
AUTH_SECRET_KEY=replace-with-a-random-32-character-or-longer-key
# Generate with cryptography.fernet.Fernet.generate_key(); required to protect admin TOTP secrets.
TOTP_ENCRYPTION_KEY=replace-with-a-fernet-key

CUSTOMER_SESSION_HOURS=24
ADMIN_SESSION_HOURS=8
PASSWORD_RESET_TOKEN_MINUTES=30

# Brevo transactional email for password resets and booking notifications.
# Keep the API key only in backend/.env; never add a VITE_ prefix.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
# New customer booking requests are independently sent to this business inbox.
BOOKING_ADMIN_EMAIL=

# Set SECURE_COOKIES=true when serving over HTTPS; defaults to true in production.
SECURE_COOKIES=false
